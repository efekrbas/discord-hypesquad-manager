{
  "name": "discord-badge-manager",
  "version": "1.0.6",
  "description": "A modern web application that lets you easily manage your Discord HypeSquad badges.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/efekrbas/discord-badge-manager.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "build": {
    "appId": "com.efekrbas.discordhypesquadmanager",
    "productName": "Discord Badge Manager",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "images/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Discord Badge Manager",
      "artifactName": "Discord.Badge.Manager.Setup.${version}.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^40.4.1",
    "electron-builder": "^26.15.3",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.3"
  }
}
